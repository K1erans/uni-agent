{
  "name": "uni-agent",
  "displayName": "Uni Agent",
  "description": "One chat UI for Claude Code, Codex and Cursor agents in VS Code.",
  "version": "0.0.1",
  "publisher": "uni-agent",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "uniAgent",
          "title": "Uni Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "uniAgent": [
        {
          "type": "webview",
          "id": "uniAgent.sidebar",
          "name": "Uni Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "uniAgent.newThread",
        "title": "New Thread",
        "category": "Uni Agent",
        "icon": "$(add)"
      },
      {
        "command": "uniAgent.newThreadWithAgent",
        "title": "New Thread With Agent…",
        "category": "Uni Agent"
      },
      {
        "command": "uniAgent.newWorktreeThread",
        "title": "New Worktree Thread…",
        "category": "Uni Agent"
      },
      {
        "command": "uniAgent.reviewWorktree",
        "title": "Review Worktree Changes",
        "category": "Uni Agent"
      },
      {
        "command": "uniAgent.openWorktree",
        "title": "Open Worktree in New Window",
        "category": "Uni Agent"
      },
      {
        "command": "uniAgent.removeWorktree",
        "title": "Remove Worktree…",
        "category": "Uni Agent"
      },
      {
        "command": "uniAgent.showThreadHistory",
        "title": "Thread History",
        "category": "Uni Agent",
        "icon": "$(history)"
      },
      {
        "command": "uniAgent.showLogs",
        "title": "Show Logs",
        "category": "Uni Agent"
      },
      {
        "command": "uniAgent.openSettings",
        "title": "Open Settings",
        "category": "Uni Agent"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "uniAgent.newThread",
          "when": "view == uniAgent.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "uniAgent.showThreadHistory",
          "when": "view == uniAgent.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "uniAgent.newThreadWithAgent",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@0"
        },
        {
          "command": "uniAgent.newWorktreeThread",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@0.5"
        },
        {
          "command": "uniAgent.reviewWorktree",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@3"
        },
        {
          "command": "uniAgent.openWorktree",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@4"
        },
        {
          "command": "uniAgent.removeWorktree",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@5"
        },
        {
          "command": "uniAgent.showLogs",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@1"
        },
        {
          "command": "uniAgent.openSettings",
          "when": "view == uniAgent.sidebar",
          "group": "1_uniAgent@2"
        }
      ]
    },
    "configuration": {
      "title": "Uni Agent",
      "properties": {
        "uniAgent.claude.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `claude` executable. Leave empty to find it on `PATH`. Machine-scoped: workspace settings cannot change which program Uni Agent runs."
        },
        "uniAgent.codex.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `codex` executable. Leave empty to find it on `PATH`. Machine-scoped: workspace settings cannot change which program Uni Agent runs."
        },
        "uniAgent.cursor.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `agent` executable (Cursor agent CLI). Leave empty to find it on `PATH`. Machine-scoped: workspace settings cannot change which program Uni Agent runs."
        },
        "uniAgent.claude.modeOverrides": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "properties": {
            "plan": {
              "type": "string",
              "enum": [
                "default",
                "acceptEdits",
                "bypassPermissions",
                "plan",
                "dontAsk",
                "auto"
              ]
            },
            "auto_edit": {
              "type": "string",
              "enum": [
                "default",
                "acceptEdits",
                "bypassPermissions",
                "plan",
                "dontAsk",
                "auto"
              ]
            },
            "full_auto": {
              "type": "string",
              "enum": [
                "default",
                "acceptEdits",
                "bypassPermissions",
                "plan",
                "dontAsk",
                "auto"
              ]
            }
          },
          "additionalProperties": false,
          "markdownDescription": "Advanced. The Claude Code permission mode to use for each Uni Agent mode (`plan`, `auto_edit`, `full_auto`) instead of the built-in one, for example `{ \"auto_edit\": \"default\" }`. An override can only make a mode stricter: one that would allow more than the built-in setting is ignored and logged. Modes left out keep the built-in mapping; an invalid value is ignored as a whole. Machine-scoped: workspace settings cannot change it."
        },
        "uniAgent.codex.modeOverrides": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "properties": {
            "plan": {
              "type": "object",
              "required": [
                "approvalPolicy",
                "sandbox"
              ],
              "additionalProperties": false,
              "properties": {
                "approvalPolicy": {
                  "type": "string",
                  "enum": [
                    "untrusted",
                    "on-request",
                    "never"
                  ]
                },
                "sandbox": {
                  "type": "string",
                  "enum": [
                    "read-only",
                    "workspace-write",
                    "danger-full-access"
                  ]
                }
              }
            },
            "auto_edit": {
              "type": "object",
              "required": [
                "approvalPolicy",
                "sandbox"
              ],
              "additionalProperties": false,
              "properties": {
                "approvalPolicy": {
                  "type": "string",
                  "enum": [
                    "untrusted",
                    "on-request",
                    "never"
                  ]
                },
                "sandbox": {
                  "type": "string",
                  "enum": [
                    "read-only",
                    "workspace-write",
                    "danger-full-access"
                  ]
                }
              }
            },
            "full_auto": {
              "type": "object",
              "required": [
                "approvalPolicy",
                "sandbox"
              ],
              "additionalProperties": false,
              "properties": {
                "approvalPolicy": {
                  "type": "string",
                  "enum": [
                    "untrusted",
                    "on-request",
                    "never"
                  ]
                },
                "sandbox": {
                  "type": "string",
                  "enum": [
                    "read-only",
                    "workspace-write",
                    "danger-full-access"
                  ]
                }
              }
            }
          },
          "additionalProperties": false,
          "markdownDescription": "Advanced. The Codex approval policy and sandbox to use for each Uni Agent mode (`plan`, `auto_edit`, `full_auto`) instead of the built-in ones, for example `{ \"auto_edit\": { \"approvalPolicy\": \"untrusted\", \"sandbox\": \"read-only\" } }`. An override can only make a mode stricter: one that would allow more than the built-in setting is ignored and logged. Modes left out keep the built-in mapping; an invalid value is ignored as a whole. Machine-scoped: workspace settings cannot change it."
        },
        "uniAgent.cursor.modeOverrides": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "properties": {
            "plan": {
              "type": "string",
              "minLength": 1
            },
            "auto_edit": {
              "type": "string",
              "minLength": 1
            },
            "full_auto": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "markdownDescription": "Advanced. The Cursor session mode ID (such as `agent`, `plan` or `ask`) to use for each Uni Agent mode (`plan`, `auto_edit`, `full_auto`) instead of the built-in one. If Cursor does not offer it, a more restrictive mode is used. An override can only make a mode stricter: one that would allow more than the built-in setting is ignored and logged. Modes left out keep the built-in mapping; an invalid value is ignored as a whole. Machine-scoped: workspace settings cannot change it."
        },
        "uniAgent.verboseLogging": {
          "type": "boolean",
          "default": false,
          "description": "Write detailed activity to the Uni Agent output channel."
        },
        "uniAgent.worktree.setupCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Command to run in each new worktree before its first turn. Configure it for this repository when dependency setup is needed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p webview",
    "lint": "eslint src webview && oxlint",
    "compile-tests": "tsc -p src/test",
    "test": "npm run test:unit && npm run test:host",
    "test:unit": "vitest run --project unit --project webview",
    "test:live": "vitest run --project live",
    "pretest:host": "npm run compile && npm run compile-tests",
    "test:host": "vscode-test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.277",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.83.0",
    "@testing-library/react": "^16.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.106.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "effect": "^3.22.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.83.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
